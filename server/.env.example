PORT=5000

# Local dev database from docker-compose.yml (host port 5433).
DATABASE_URL=postgres://devblog:devblog@localhost:5433/devblog

# Hosted Postgres (Neon, Supabase, Render) terminates TLS with a certificate
# that is not in Node's default trust store. Set this to true for those.
DATABASE_SSL=false

# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
