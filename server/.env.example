PORT=5000

# Number of reverse proxies in front of the app, so the rate limiter can read
# the real client IP from X-Forwarded-For. 0 for local, 1 behind a single proxy
# (Render, Fly, Nginx). Do not use `true` — it lets clients forge their IP.
TRUST_PROXY=0

# Local dev database from docker-compose.yml (host port 5433).
DATABASE_URL=postgres://devblog:devblog@localhost:5433/devblog

# Hosted Postgres (Neon, Supabase, Render) terminates TLS with a certificate
# that is not in Node's default trust store. Set this to true for those.
DATABASE_SSL=false

# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string
